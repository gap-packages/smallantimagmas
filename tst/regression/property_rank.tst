gap> START_TEST("property_rank.tst");

## Catalogue ids two-generated antimagmas of order 4.
gap> ids := Filtered([1 .. NrSmallAntimagmas(4)], i -> Rank(SmallAntimagma(4, i)) = 2);
[    1,    3,    5,   16,   18,   20,   22,   33,   35,   37,
    61,   65,   69,   73,  110,  111,  115,  116,  118,  125,
